@using Motivation.HRWeb.Components.Pages.KpiPage.Models

@typeparam TItem where TItem : KpiFilterItemModel, new()

<div class="mt-3">
    <h6 class="small fw-bold mb-2">@Title</h6>
    <div class="d-flex flex-column gap-1 mb-2">
        @foreach (var item in Items.Select((value, index) => new { value, index }))
        {
            var idx = item.index;
            <div class="d-flex gap-2">
                <input type="text" class="form-control form-control-sm"
                       @bind="Items[idx].Title"
                       placeholder="Введите значение..." />

                <div class="form-check d-flex align-items-center mt-1">
                    <input class="form-check-input" type="checkbox"
                           @bind="Items[idx].Include"
                           id="@(IdPrefix)_@idx" />
                    <label class="form-check-label small ms-1" for="@(IdPrefix)_@idx">Вкл.</label>
                </div>

                <button class="btn btn-outline-danger btn-sm" @onclick="() => OnRemove.InvokeAsync(idx)">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        }

        <button class="btn btn-outline-primary btn-sm align-self-start mt-1" @onclick="OnAdd">
            + @AddButtonText
        </button>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string AddButtonText { get; set; } = "Добавить";
    [Parameter] public string IdPrefix { get; set; } = "filter";

    [Parameter] public List<TItem> Items { get; set; } = new();
    [Parameter] public EventCallback OnAdd { get; set; }
    [Parameter] public EventCallback<int> OnRemove { get; set; }
}