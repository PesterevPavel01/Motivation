@using Mediator
@using Motivation.HRWeb.Application.Messages.KpiMessages
@using Motivation.HRWeb.Components.Pages.KpiPage.Models
@inject IMediator Mediator

@if (Kpi != null)
{
    <div class="modal fade show" style="display:block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fs-6 text-danger">Подтверждение удаления</h5>
                    <button type="button" class="btn-close" @onclick="OnCancel"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <div class="alert alert-danger small">@ErrorMessage</div>
                    }
                    <p class="small fw-bold mb-2">Вы действительно хотите безвозвратно удалить этот показатель KPI?</p>
                    <ul class="list-group list-group-flush small">
                        <li class="list-group-item py-1">
                            <strong>Код:</strong> @Kpi.Code
                        </li>
                        <li class="list-group-item py-1">
                            <strong>Наименование:</strong> @Kpi.Title
                        </li>
                    </ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="OnCancel">Отмена</button>
                    <button type="button" class="btn btn-danger btn-sm" @onclick="HandleDelete" disabled="@IsDeleting">
                        @(IsDeleting ? "Удаление..." : "Удалить")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public KpiRowModel? Kpi { get; set; }
    [Parameter] public EventCallback OnDeleted { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    public string? ErrorMessage { get; set; }

    private bool IsDeleting { get; set; }

    private async Task HandleDelete()
    {
        if (Kpi is null) 
            return;

        try
        {
            IsDeleting = true;
            var result = await Mediator.Send(new DeleteKpi.Request(Kpi.Code));
            if (!result.Ok)
            {
                ErrorMessage = result.Error;
            }
            else
            {
                await OnDeleted.InvokeAsync();
            }
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsDeleting = false;
        }
    }
}