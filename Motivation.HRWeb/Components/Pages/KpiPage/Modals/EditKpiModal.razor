@using Mediator
@using Motivation.HRWeb.Components.Pages.KpiPage.Components
@using Motivation.HRWeb.Components.Pages.KpiPage.Models
@using Motivation.HRWeb.Components.Pages.KpiPage.ViewModels
@inject KpiViewModel KpiViewModel
@inject IMediator Mediator

@if (Kpi != null || IsNew)
{
    <div class="modal fade show" style="display:block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fs-6">@(IsNew ? "Добавление" : "Редактирование") показателя KPI</h5>
                    <button type="button" class="btn-close" @onclick="OnCancel"></button>
                </div>

                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(EditViewModel.ErrorMessage))
                    {
                        <div class="alert alert-danger small">@EditViewModel.ErrorMessage</div>
                    }

                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Наименование</label>
                            <input type="text" class="form-control form-control-sm" @bind="EditViewModel.Title" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Краткое наименование</label>
                            <input type="text" class="form-control form-control-sm" @bind="EditViewModel.Abbreviation" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Порядок расчета</label>
                            <select class="form-select form-select-sm" @bind="EditViewModel.CalculationType">
                                <option value="">@AppData.SelectOption</option>
                                @foreach (var calculationType in KpiViewModel.CalculationTypes)
                                {
                                    <option value="@calculationType.Title">
                                        @calculationType.Title
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Единица измерения</label>
                            <select class="form-select form-select-sm" @bind="EditViewModel.MeasurementUnit.Code">
                                <option value="">@AppData.SelectOption</option>
                                @foreach (var unit in KpiViewModel.Units)
                                {
                                    <option value="@unit.Code">
                                        @unit.Title
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Тип KPI</label>
                            <select class="form-select form-select-sm" @bind="EditViewModel.KpiType">
                                <option value="">@AppData.SelectOption</option>
                                @foreach (var type in KpiViewModel.KpiTypes)
                                {
                                    <option value="@type.Title">
                                        @type.Title
                                    </option>
                                }
                            </select>
                        </div>
                    </div>

                    <KpiFilter Title="Фильтр Клиенты"
                               AddButtonText="Добавить клиента"
                               IdPrefix="cust"
                               Items="EditViewModel.CustomerFilter"
                               OnAdd="EditViewModel.AddCustomerFilter"
                               OnRemove="EditViewModel.RemoveCustomerFilter" />

                    <KpiFilter Title="Фильтр Продукты"
                               AddButtonText="Добавить продукт"
                               IdPrefix="prod"
                               Items="EditViewModel.ProductFilter"
                               OnAdd="EditViewModel.AddProductFilter"
                               OnRemove="EditViewModel.RemoveProductFilter" />

                    <KpiFilter Title="Фильтр Организации"
                               AddButtonText="Добавить организацию"
                               IdPrefix="comp"
                               Items="EditViewModel.CompanyFilter"
                               OnAdd="EditViewModel.AddCompanyFilter"
                               OnRemove="EditViewModel.RemoveCompanyFilter" />
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="OnCancel">Отмена</button>
                    <button type="button" class="btn btn-success btn-sm" @onclick="HandleSave" disabled="@EditViewModel.IsSaving">
                        @(EditViewModel.IsSaving ? "Сохранение..." : "Сохранить")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public KpiRowModel? Kpi { get; set; }
    [Parameter] public bool IsNew { get; set; } = false;
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    EditKpiViewModel EditViewModel = null!;

    protected override void OnParametersSet()
    {
        EditViewModel = EditKpiViewModel.Create(Mediator, IsNew ? null : Kpi);
    }

    private async Task HandleSave()
    {
        if (!EditViewModel.IsValid())
            return;

        var KpiCode = await EditViewModel.SaveAsync(IsNew ? null : Kpi!.Code, IsNew);
        if (KpiCode.Ok)
        {
            await OnSaved.InvokeAsync();
        }
    }
}