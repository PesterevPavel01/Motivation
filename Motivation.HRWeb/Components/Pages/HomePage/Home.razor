@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Motivation.HRWeb.Components.Pages.HomePage.ViewModels
@using Motivation.HRWeb.Components.Pages.HomePage.Components
@using Motivation.HRWeb.Application
@inject HomeViewModel HomeVm
@inject FilterViewModel FilterVm
@attribute [Authorize]

<PageTitle>Матрица</PageTitle>

<div class="row align-items-start mb-3">
    <div class="row col-12 col-md-8">
        <h1 class="fs-4 m-0">Матрица</h1>
        @if (HomeVm.LeftTableData.Any())
        {
            <div class="col-12 col-lg-4">
                <div class="table-responsive shadow-sm rounded bg-white p-2">
                    <table class="table table-sm table-hover table-bordered align-middle small mb-0">
                        <tbody>
                            @foreach (var item in HomeVm.LeftTableData)
                            {
                                <tr>
                                    <td class="py-1"><strong>@item.Parameter</strong></td>
                                    <td class="py-1">@item.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
    <div class="col-12 col-md-4">
        <FilterComponent ViewModel="FilterVm" OnApplyFilter="ApplyFilter" />
    </div>
</div>

@if (HomeVm.IsLoading)
{
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Загрузка...</span>
    </div>
}
else if (!string.IsNullOrEmpty(HomeVm.ErrorMessage))
{
    <div class="alert alert-danger">@HomeVm.ErrorMessage</div>
}
else
{
    @if (!HomeVm.KpiTableData.Any())
    {
        <div class="alert alert-info">Нет данных для отображения. Выберите сотрудника и нажмите "Применить".</div>
    }
    else
    {
        <div class="g-3">
            <div class="mt-3 table-responsive shadow-sm rounded bg-white p-2">
                <table class="table table-sm table-hover table-bordered align-middle small mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="py-1">Показатель</th>
                            <th class="py-1">Ед. изм.</th>
                            <th class="py-1 text-center">Цель</th>
                            <th class="py-1 text-center">Премия</th>
                            <th class="py-1 text-center">Факт</th>
                            <th class="py-1 text-center">Выполнение</th>
                            <th class="py-1 text-center">% Премии</th>
                            <th class="py-1 text-center">Бонус</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in HomeVm.KpiTableData)
                        {
                            <tr>
                                <td class="py-1">@row.KpiTitle</td>
                                <td class="py-1">@row.MeasurementUnit</td>
                                <td class="py-1 text-center">@ValueFormatter.FormatValue(row.Target)</td>
                                <td class="py-1 text-center">@ValueFormatter.FormatValue(row.MotivationPart)</td>
                                <td class="py-1 text-center">@ValueFormatter.FormatValue(row.Fact)</td>
                                <td class="py-1 text-center">@ValueFormatter.FormatValue(row.Achievement)</td>
                                <td class="py-1 text-center">@ValueFormatter.FormatValue(row.MotivationPartPercent)</td>
                                <td class="py-1 text-center">@ValueFormatter.FormatValue(row.Bonus)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private async Task ApplyFilter()
    {
        await HomeVm.LoadDataAsync(
            FilterVm.Filter.EmployeeCode ?? string.Empty,
            FilterVm.Filter.PositionCode ?? string.Empty,
            FilterVm.Filter.Month,
            FilterVm.Filter.Year);
    }

    protected override async Task OnInitializedAsync()
    {
        await FilterVm.LoadEmployeesAsync();
    }
}