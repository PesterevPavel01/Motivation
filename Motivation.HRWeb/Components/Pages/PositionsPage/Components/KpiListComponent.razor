<div class="mt-3">
    <h6 class="fw-bold mb-2">Закрепленные KPI</h6>

    <!-- Единое место для всех ошибок -->
    @if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
    {
        <div class="alert alert-danger alert-sm py-1 mb-2">
            <i class="bi bi-exclamation-triangle-fill me-1"></i>
            @ViewModel.ErrorMessage
        </div>
    }

    @if (ViewModel.IsLoading)
    {
        <div class="text-center py-2">
            <div class="spinner-border spinner-border-sm text-primary" role="status">
                <span class="visually-hidden">Загрузка KPI...</span>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle small mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-1" style="width: 70px;">№</th>
                        <th class="py-1">Наименование KPI</th>
                        <th class="py-1" style="width: 120px;">Вес задачи</th>
                        <th class="py-1" style="width: 130px;">Действует с</th>
                        <th class="py-1" style="width: 130px;">Действует до</th>
                        <th class="py-1 text-center" style="width: 100px;">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewModel.Items.Any())
                    {
                        @foreach (var item in ViewModel.Items.OrderBy(x => x.OrderNumber))
                        {
                            <tr>
                                <td class="py-1">
                                    @if (item.IsEditing || item.IsNew)
                                    {
                                        <input type="number" class="form-control form-control-sm"
                                               @bind="item.OrderNumber" @bind:event="oninput" min="1" />
                                    }
                                    else
                                    {
                                        <span class="d-block text-center">@item.OrderNumber</span>
                                    }
                                </td>
                                <td class="py-1">
                                    @if (item.IsEditing || item.IsNew)
                                    {
                                        <select class="form-select form-select-sm" @bind="item.KpiCode">
                                            <option value="">-- Выберите KPI --</option>
                                            @foreach (var kpi in ViewModel.AvailableKpis)
                                            {
                                                <option value="@kpi.Code">@kpi.Title</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <span>@item.KpiTitle</span>
                                    }
                                </td>
                                <td class="py-1">
                                    @if (item.IsEditing || item.IsNew)
                                    {
                                        <input type="number" class="form-control form-control-sm"
                                               @bind="item.Weight" @bind:event="oninput" step="0.01" min="0" />
                                    }
                                    else
                                    {
                                        <span>@item.Weight</span>
                                    }
                                </td>
                                <td class="py-1">
                                    @if (item.IsEditing || item.IsNew)
                                    {
                                        <input type="date" class="form-control form-control-sm"
                                               @bind="item.ValidFrom" @bind:format="yyyy-MM-dd" />
                                    }
                                    else
                                    {
                                        <span>@item.ValidFrom.ToShortDateString()</span>
                                    }
                                </td>
                                <td class="py-1">
                                    @if (item.IsEditing || item.IsNew)
                                    {
                                        <input type="date" class="form-control form-control-sm"
                                               @bind="item.ValidTo" @bind:format="yyyy-MM-dd" />
                                    }
                                    else
                                    {
                                        <span>@item.ValidTo.ToShortDateString()</span>
                                    }
                                </td>
                                <td class="py-1 text-center">
                                    @if (item.IsNew)
                                    {
                                        <div class="d-flex justify-content-center gap-1">
                                            <button type="button" class="btn btn-success btn-sm"
                                                    @onclick="() => ViewModel.SaveNewItem(item)"
                                                    title="Сохранить">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                            <button type="button" class="btn btn-danger btn-sm"
                                                    @onclick="() => ViewModel.CancelNewItem(item)"
                                                    title="Отмена">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                    }
                                    else if (item.IsEditing)
                                    {
                                        <div class="d-flex justify-content-center gap-1">
                                            <button type="button" class="btn btn-success btn-sm"
                                                    @onclick="() => ViewModel.SaveEditItem(item)"
                                                    title="Сохранить">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                            <button type="button" class="btn btn-secondary btn-sm"
                                                    @onclick="() => ViewModel.CancelEditItem(item)"
                                                    title="Отмена">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex justify-content-center gap-1">
                                            <button type="button" class="btn btn-outline-primary btn-sm"
                                                    @onclick="() => ViewModel.StartEditItem(item)"
                                                    title="Редактировать">
                                                <i class="bi bi-pencil-fill"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger btn-sm"
                                                    @onclick="() => ViewModel.RemoveItem(item)"
                                                    title="Удалить">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }

                        @if (ViewModel.ShowNewRow)
                        {
                            <tr>
                                <td class="py-1">
                                    <input type="number" class="form-control form-control-sm"
                                           @bind="ViewModel.NewKpi.OrderNumber" @bind:event="oninput" min="1" />
                                </td>
                                <td class="py-1">
                                    <select class="form-select form-select-sm" @bind="ViewModel.NewKpi.KpiCode">
                                        <option value="">-- Выберите KPI --</option>
                                        @foreach (var kpi in ViewModel.AvailableKpis)
                                        {
                                            <option value="@kpi.Code">@kpi.Title</option>
                                        }
                                    </select>
                                </td>
                                <td class="py-1">
                                    <input type="number" class="form-control form-control-sm"
                                           @bind="ViewModel.NewKpi.Weight" @bind:event="oninput" step="0.01" min="0" />
                                </td>
                                <td class="py-1">
                                    <input type="date" class="form-control form-control-sm"
                                           @bind="ViewModel.NewKpi.ValidFrom" @bind:format="yyyy-MM-dd" />
                                </td>
                                <td class="py-1">
                                    <input type="date" class="form-control form-control-sm"
                                           @bind="ViewModel.NewKpi.ValidTo" @bind:format="yyyy-MM-dd" />
                                </td>
                                <td class="py-1 text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        <button type="button" class="btn btn-success btn-sm"
                                                @onclick="ViewModel.AddNewKpi"
                                                title="Добавить">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                        <button type="button" class="btn btn-secondary btn-sm"
                                                @onclick="ViewModel.CancelNewRow"
                                                title="Отмена">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-1">
                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ViewModel.ShowAddRow">
                                        <i class="bi bi-plus-lg"></i> Добавить KPI
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-2">
                                Нет закрепленных KPI
                            </td>
                        </tr>

                        @if (ViewModel.ShowNewRow)
                        {
                            <tr>
                                <td class="py-1">
                                    <input type="number" class="form-control form-control-sm"
                                           @bind="ViewModel.NewKpi.OrderNumber" @bind:event="oninput" min="1" />
                                </td>
                                <td class="py-1">
                                    <select class="form-select form-select-sm" @bind="ViewModel.NewKpi.KpiCode">
                                        <option value="">-- Выберите KPI --</option>
                                        @foreach (var kpi in ViewModel.AvailableKpis)
                                        {
                                            <option value="@kpi.Code">@kpi.Title</option>
                                        }
                                    </select>
                                </td>
                                <td class="py-1">
                                    <input type="number" class="form-control form-control-sm"
                                           @bind="ViewModel.NewKpi.Weight" @bind:event="oninput" step="0.01" min="0" />
                                </td>
                                <td class="py-1">
                                    <input type="date" class="form-control form-control-sm"
                                           @bind="ViewModel.NewKpi.ValidFrom" @bind:format="yyyy-MM-dd" />
                                </td>
                                <td class="py-1">
                                    <input type="date" class="form-control form-control-sm"
                                           @bind="ViewModel.NewKpi.ValidTo" @bind:format="yyyy-MM-dd" />
                                </td>
                                <td class="py-1 text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        <button type="button" class="btn btn-success btn-sm"
                                                @onclick="ViewModel.AddNewKpi"
                                                title="Добавить">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                        <button type="button" class="btn btn-secondary btn-sm"
                                                @onclick="ViewModel.CancelNewRow"
                                                title="Отмена">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-1">
                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ViewModel.ShowAddRow">
                                        <i class="bi bi-plus-lg"></i> Добавить KPI
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>