@using Motivation.HRWeb.Components.Pages.PositionsPage.ViewModels

<div class="modal fade show" style="display:block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fs-6 text-danger">Подтверждение удаления</h5>
                <button type="button" class="btn-close" @onclick="OnCancel"></button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
                {
                    <div class="alert alert-danger small mb-3">@ViewModel.ErrorMessage</div>
                }
                <p class="small fw-bold mb-2">Удалить должность <strong>@ViewModel.PositionTitle</strong>?</p>
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item py-1"><strong>Код:</strong> @ViewModel.PositionCode</li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="OnCancel">Отмена</button>
                <button type="button" class="btn btn-danger btn-sm" @onclick="HandleDelete" disabled="@ViewModel.IsDeleting">
                    @(ViewModel.IsDeleting ? "Удаление..." : "Удалить")
                </button>
            </div>
        </div>
    </div>
</div>