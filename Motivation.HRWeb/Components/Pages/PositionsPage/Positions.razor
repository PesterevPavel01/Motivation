@page "/positions"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Motivation.HRWeb.Components.Pages.PositionsPage.Modals
@attribute [Authorize]

<PageTitle>Должности</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="fs-4 m-0">Должности</h1>
    <button class="btn btn-primary btn-sm" @onclick="() => ViewModel.OpenCreateModal()">
        <i class="bi bi-plus-lg"></i> Добавить должность
    </button>
</div>

@if (ViewModel.IsLoading)
{
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Загрузка...</span>
    </div>
}
else if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>Ошибка:</strong> @ViewModel.ErrorMessage
    </div>
}
else if (ViewModel.Positions == null || !ViewModel.Positions.Any())
{
    <div class="alert alert-info">Должности не найдены.</div>
}
else
{
    <div class="table-responsive shadow-sm rounded bg-white p-2">
        <table class="table table-sm table-hover table-bordered align-middle small mb-0">
            <thead class="table-light">
                <tr>
                    <th class="py-1">Название</th>
                    <th class="py-1">Оклад</th>
                    <th class="py-1">Премия</th>
                    <th class="py-1">Тип недели</th>
                    <th class="py-1 text-center">Пересчет на часы</th>
                    <th class="py-1 text-center" style="width: 110px;">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pos in ViewModel.Positions)
                {
                    <tr>
                        <td class="py-1"><strong>@pos.Title</strong></td>
                        <td class="py-1">@pos.BaseSalary</td>
                        <td class="py-1">@pos.MotivationPart</td>
                        <td class="py-1">@pos.WorkWeekType</td>
                        <td class="py-1 text-center">
                            @(pos.RecalculateToHours ? "Да" : "Нет")
                        </td>
                        <td class="py-1 text-center">
                            <button class="btn btn-outline-secondary btn-sm me-1"
                                    @onclick="() => ViewModel.OpenEditModal(pos)"
                                    title="Редактировать">
                                <i class="bi bi-pencil-fill"></i>
                            </button>
                            <button class="btn btn-outline-secondary btn-sm"
                                    @onclick="() => ViewModel.OpenDeleteModal(pos)"
                                    title="Удалить">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-2 d-flex justify-content-between align-items-center">
        <div>
            <span class="badge bg-secondary">Всего: @ViewModel.PositionsCount</span>
        </div>
    </div>
}

@if (ViewModel.ShowCreateModal)
{
    <PositionModal IsEditMode="false"
                   OnSaved="ViewModel.OnPositionCreatedAsync"
                   OnCancel="ViewModel.CloseModals" />
}

@if (ViewModel.ShowEditModal && ViewModel.SelectedPosition != null)
{
    <PositionModal IsEditMode="true"
                   Position="@ViewModel.SelectedPosition"
                   OnSaved="ViewModel.OnPositionUpdatedAsync"
                   OnCancel="ViewModel.CloseModals" />
}

@if (ViewModel.ShowDeleteModal && ViewModel.SelectedPosition != null)
{
    <DeletePositionModal Position="@ViewModel.SelectedPosition"
                         OnDeleted="ViewModel.OnPositionDeletedAsync"
                         OnCancel="ViewModel.CloseModals" />
}