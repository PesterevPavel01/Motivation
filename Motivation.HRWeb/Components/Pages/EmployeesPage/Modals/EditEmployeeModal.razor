@using Motivation.HRWeb.Components.Pages.EmployeesPage.ViewModels
@using Motivation.HRWeb.Components.Pages.EmployeesPage.Models

<div class="modal fade show" style="display:block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fs-6">Редактирование сотрудника</h5>
                <button type="button" class="btn-close" @onclick="OnCancel"></button>
            </div>
            <EditForm Model="ViewModel.Model" OnValidSubmit="HandleSubmit">
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
                    {
                        <div class="alert alert-danger small mb-3">@ViewModel.ErrorMessage</div>
                    }
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Код</label>
                        <input type="text" class="form-control form-control-sm" value="@ViewModel.Model.Code" disabled />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Фамилия</label>
                        <InputText class="form-control form-control-sm" @bind-Value="ViewModel.Model.LastName" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Имя</label>
                        <InputText class="form-control form-control-sm" @bind-Value="ViewModel.Model.FirstName" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Отчество</label>
                        <InputText class="form-control form-control-sm" @bind-Value="ViewModel.Model.SecondName" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Полное имя</label>
                        <InputText class="form-control form-control-sm" @bind-Value="ViewModel.Model.FullName" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="OnCancel">Отмена</button>
                    <button type="submit" class="btn btn-success btn-sm" disabled="@ViewModel.IsLoading">
                        @(ViewModel.IsLoading ? "Сохранение..." : "Сохранить")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter] public EmployeeItemModel Employee { get; set; } = null!;
    [Parameter] public EditEmployeeModalViewModel ViewModel { get; set; } = null!;
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task HandleSubmit()
    {
        if (await ViewModel.UpdateAsync())
            await OnSaved.InvokeAsync();
    }
}