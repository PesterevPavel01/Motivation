@using Mediator
@using Motivation.Contracts.Dto
@using Motivation.HRWeb.Application.Mappings
@using Motivation.HRWeb.Application.Messages.EmployeeMessages
@using Motivation.HRWeb.Components.Pages.Employees.Models
@inject IMediator Mediator

<div class="modal fade show" style="display:block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fs-6">Редактирование сотрудника</h5>
                <button type="button" class="btn-close" @onclick="OnCancel"></button>
            </div>

            <EditForm Model="editModel" OnValidSubmit="HandleSave">
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(createErrorMessage))
                    {
                        <div class="alert alert-danger small mb-3">
                            <strong>Ошибка:</strong> @createErrorMessage
                        </div>
                    }
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Код (не редактируется)</label>
                        <input type="text" class="form-control form-control-sm" value="@editModel.Code" disabled />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Фамилия</label>
                        <InputText class="form-control form-control-sm" @bind-Value="editModel.LastName" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Имя</label>
                        <InputText class="form-control form-control-sm" @bind-Value="editModel.FirstName" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Отчество</label>
                        <InputText class="form-control form-control-sm" @bind-Value="editModel.SecondName" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Полное имя</label>
                        <InputText class="form-control form-control-sm" @bind-Value="editModel.FullName" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="OnCancel">Отмена</button>
                    <button type="submit" class="btn btn-success btn-sm" disabled="@isSaving">
                        @(isSaving ? "Сохранение..." : "Сохранить")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter] public EmployeeDto? Employee { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private EditEmployeeModel editModel = new();
    private bool isSaving = false;
    private string? createErrorMessage;

    protected override void OnParametersSet()
    {
        if (Employee != null)
        {
            editModel.Code = Employee.Code;
            editModel.LastName = Employee.LastName;
            editModel.FirstName = Employee.FirstName;
            editModel.SecondName = Employee.SecondName;
            editModel.FullName = Employee.FullName;
        }
    }

    private async Task HandleSave()
    {
        if (string.IsNullOrEmpty(editModel.Code)) return;

        try
        {
            isSaving = true;
            var dtoToSend = editModel.ToUpdateDto();
            var result = await Mediator.Send(new UpdateEmployee.Request(dtoToSend));
            if (!result.Ok)
            {
                createErrorMessage = result.Error ?? "Ошибка при обновлении сотрудника.";
            }
            else
            {
                await OnSaved.InvokeAsync();
            }
        }
        finally
        {
            isSaving = false;
        }
    }
}