@using Mediator
@using Motivation.HRWeb.Application.Mappings
@using Motivation.HRWeb.Application.Messages.EmployeeMessages
@using Motivation.HRWeb.Components.Pages.Employees.Models
@inject IMediator Mediator

<div class="modal fade show" style="display:block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fs-6">Добавление нового сотрудника</h5>
                <button type="button" class="btn-close" @onclick="OnCancel"></button>
            </div>

            <EditForm Model="createModel" OnValidSubmit="HandleCreate">
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(createErrorMessage))
                    {
                        <div class="alert alert-danger small mb-3">
                            <strong>Ошибка:</strong> @createErrorMessage
                        </div>
                    }
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Код</label>
                        <input type="text" class="form-control form-control-sm"
                               value="@(string.IsNullOrEmpty(createModel.Code) ? "Будет сгенерирован автоматически" : createModel.Code)"
                               disabled="disabled"
                               style="background-color: #e9ecef;" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Фамилия *</label>
                        <InputText class="form-control form-control-sm" @bind-Value="createModel.LastName" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Имя *</label>
                        <InputText class="form-control form-control-sm" @bind-Value="createModel.FirstName" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Отчество</label>
                        <InputText class="form-control form-control-sm" @bind-Value="createModel.SecondName" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Полное имя *</label>
                        <InputText class="form-control form-control-sm" @bind-Value="createModel.FullName" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="OnCancel">Отмена</button>
                    <button type="submit" class="btn btn-primary btn-sm" disabled="@isCreating">
                        @(isCreating ? "Сохранение..." : "Добавить")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnCreated { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private CreateEmployeeModel createModel = new();
    private bool isCreating = false;
    private string? createErrorMessage;

    private async Task HandleCreate()
    {
        try
        {
            isCreating = true;
            var dtoToSend = createModel.ToCreateDto();
            var creationResult = await Mediator.Send(new CreateEmployee.Request(dtoToSend));
            if (!creationResult.Ok)
            {
                createErrorMessage = creationResult.Error ?? "Неизвестная ошибка при создании сотрудника.";
            }
            else
            {
                await OnCreated.InvokeAsync();
            } 
        }
        finally
        {
            isCreating = false;
        }
    }
}