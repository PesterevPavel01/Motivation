@using Mediator
@using Motivation.Contracts.Dto
@using Motivation.HRWeb.Application.Messages.EmployeeMessages
@inject IMediator Mediator

<div class="modal fade show" style="display:block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fs-6 text-danger">Подтверждение удаления</h5>
                <button type="button" class="btn-close" @onclick="OnCancel"></button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(createErrorMessage))
                {
                    <div class="alert alert-danger small mb-3">
                        <strong>Ошибка:</strong> @createErrorMessage
                    </div>
                }
                <p class="small fw-bold mb-2">Вы действительно хотите безвозвратно удалить этого сотрудника?</p>
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item py-1"><strong>Код:</strong> @Employee?.Code</li>
                    <li class="list-group-item py-1"><strong>ФИО:</strong> @Employee?.FullName</li>
                    @if (Employee?.Positions != null && Employee.Positions.Any())
                    {
                        <li class="list-group-item py-1">
                            <strong>Должности:</strong>
                            <ul class="list-unstyled mb-0 ps-2">
                                @foreach (var pos in Employee.Positions)
                                {
                                    <li>- @(pos.Position?.Title ?? "без названия")</li>
                                }
                            </ul>
                        </li>
                    }
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="OnCancel">Отмена</button>
                <button type="button" class="btn btn-danger btn-sm" @onclick="HandleDelete" disabled="@isDeleting">
                    @(isDeleting ? "Удаление..." : "Удалить")
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public EmployeeDto? Employee { get; set; }
    [Parameter] public EventCallback OnDeleted { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool isDeleting = false;
    private string? createErrorMessage;

    private async Task HandleDelete()
    {
        if (Employee == null) return;

        try
        {
            isDeleting = true;
            var result = await Mediator.Send(new DeleteEmployee.Request(Employee.Code));
            if (!result.Ok)
            {
                createErrorMessage = result.Error ?? "Ошибка при удалении сотрудника.";
            }
            else
            {
                await OnDeleted.InvokeAsync();
            }           
        }
        finally
        {
            isDeleting = false;
        }
    }
}