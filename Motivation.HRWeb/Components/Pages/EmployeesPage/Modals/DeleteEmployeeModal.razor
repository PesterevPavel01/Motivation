@using Motivation.HRWeb.Components.Pages.EmployeesPage.ViewModels
@using Motivation.HRWeb.Components.Pages.EmployeesPage.Models

<div class="modal fade show" style="display:block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fs-6 text-danger">Подтверждение удаления</h5>
                <button type="button" class="btn-close" @onclick="OnCancel"></button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
                {
                    <div class="alert alert-danger small mb-3">@ViewModel.ErrorMessage</div>
                }
                <p class="small fw-bold mb-2">Вы действительно хотите удалить сотрудника?</p>
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item py-1"><strong>Код:</strong> @ViewModel.Employee?.Code</li>
                    <li class="list-group-item py-1"><strong>ФИО:</strong> @ViewModel.Employee?.FullName</li>
                    @if (ViewModel.Employee?.Positions?.Any() == true)
                    {
                        <li class="list-group-item py-1">
                            <strong>Должности:</strong>
                            <ul class="list-unstyled mb-0 ps-2">
                                @foreach (var pos in ViewModel.Employee.Positions)
                                {
                                    <li>- @pos.PositionTitle</li>
                                }
                            </ul>
                        </li>
                    }
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="OnCancel">Отмена</button>
                <button type="button" class="btn btn-danger btn-sm" @onclick="HandleDelete" disabled="@ViewModel.IsLoading">
                    @(ViewModel.IsLoading ? "Удаление..." : "Удалить")
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public EmployeeItemModel Employee { get; set; } = null!;
    [Parameter] public DeleteEmployeeModalViewModel ViewModel { get; set; } = null!;
    [Parameter] public EventCallback OnDeleted { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task HandleDelete()
    {
        if (await ViewModel.DeleteAsync())
            await OnDeleted.InvokeAsync();
    }
}