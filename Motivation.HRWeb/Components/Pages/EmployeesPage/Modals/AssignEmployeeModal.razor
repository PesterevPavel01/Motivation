@using Motivation.HRWeb.Components.Pages.EmployeesPage.Models
@using Motivation.HRWeb.Components.Pages.EmployeesPage.ViewModels

<div class="modal fade show" style="display:block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fs-6">Назначение на должность</h5>
                <button type="button" class="btn-close" @onclick="OnCancel"></button>
            </div>
            <EditForm Model="ViewModel.Model" OnValidSubmit="HandleSubmit">
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
                    {
                        <div class="alert alert-danger small mb-3">@ViewModel.ErrorMessage</div>
                    }
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Сотрудник</label>
                        <input type="text" class="form-control form-control-sm" value="@ViewModel.Employee?.FullName" disabled />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Должность *</label>
                        <InputSelect class="form-select form-select-sm" @bind-Value="ViewModel.Model.SelectedPositionCode">
                            <option value="">-- Выберите должность --</option>
                            @foreach (var pos in ViewModel.Positions)
                            {
                                <option value="@pos.Code">@pos.Title</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Дата назначения *</label>
                        <InputDate class="form-control form-control-sm" @bind-Value="ViewModel.Model.AssignmentDate" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="OnCancel">Отмена</button>
                    <button type="submit" class="btn btn-primary btn-sm" disabled="@(ViewModel.IsLoading || string.IsNullOrEmpty(ViewModel.Model.SelectedPositionCode))">
                        @(ViewModel.IsLoading ? "Назначение..." : "Назначить")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter] public AssignEmployeeModalViewModel ViewModel { get; set; } = null!;
    [Parameter] public EmployeeItemModel Employee { get; set; } = null!;
    [Parameter] public EventCallback OnAssigned { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task HandleSubmit()
    {
        if (await ViewModel.AssignAsync())
            await OnAssigned.InvokeAsync();
    }
}