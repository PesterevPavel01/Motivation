@page "/employees"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Motivation.HRWeb.Components.Pages.EmployeesPage.ViewModels
@using Motivation.HRWeb.Components.Pages.EmployeesPage.Modals
@inject EmployeesViewModel ViewModel
@attribute [Authorize]

<PageTitle>Сотрудники</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="fs-4 m-0">Сотрудники</h1>
    <button class="btn btn-primary btn-sm" @onclick="() => ViewModel.OpenCreateModal()">
        <i class="bi bi-plus-lg"></i> Добавить сотрудника
    </button>
</div>

@if (ViewModel.IsLoading)
{
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Загрузка...</span>
    </div>
}
else if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>Ошибка:</strong> @ViewModel.ErrorMessage
    </div>
}
else if (!ViewModel.Employees.Any())
{
    <div class="alert alert-info">Сотрудники не найдены.</div>
}
else
{
    <div class="table-responsive shadow-sm rounded bg-white p-2">
        <table class="table table-sm table-hover table-bordered align-middle small mb-0">
            <thead class="table-light">
                <tr>
                    <th class="py-1">Фамилия</th>
                    <th class="py-1">Имя</th>
                    <th class="py-1">Отчество</th>
                    <th class="py-1">Полное имя</th>
                    <th class="py-1">Должности</th>
                    <th class="py-1 text-center" style="min-width: 220px;">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var emp in ViewModel.Employees)
                {
                    <tr>
                        <td class="py-1">@emp.LastName</td>
                        <td class="py-1">@emp.FirstName</td>
                        <td class="py-1">@(emp.SecondName ?? "—")</td>
                        <td class="py-1"><strong>@emp.FullName</strong></td>
                        <td class="py-1">
                            @if (emp.Positions.Any())
                            {
                                <ul class="list-unstyled mb-0">
                                    @foreach (var pos in emp.Positions)
                                    {
                                        <li class="small">@pos.PositionTitle</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span class="text-muted">нет</span>
                            }
                        </td>
                        <td class="py-1 text-center text-nowrap">
                            <button class="btn btn-outline-primary btn-sm me-1"
                                    @onclick="() => ViewModel.OpenAssignModalAsync(emp)"
                                    title="Назначить на должность">
                                <i class="bi bi-person-plus-fill"></i>
                            </button>
                            @if (ViewModel.HasPositions(emp))
                            {
                                <button class="btn btn-outline-danger btn-sm me-1"
                                        @onclick="() => ViewModel.OpenDismissModalAsync(emp)"
                                        title="Уволить с должности">
                                    <i class="bi bi-person-dash-fill"></i>
                                </button>
                            }
                            <button class="btn btn-outline-secondary btn-sm me-1"
                                    @onclick="() => ViewModel.OpenEditModal(emp)"
                                    title="Редактировать">
                                <i class="bi bi-pencil-fill"></i>
                            </button>
                            <button class="btn btn-outline-secondary btn-sm"
                                    @onclick="() => ViewModel.OpenDeleteModal(emp)"
                                    title="Удалить">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-2">
        <span class="badge bg-secondary">Всего: @ViewModel.EmployeesCount</span>
    </div>
}

@if (ViewModel.ShowCreateModal)
{
    <CreateEmployeeModal ViewModel="ViewModel.CreateModalViewModel" 
                         OnCreated="ViewModel.OnEmployeeCreatedAsync"
                         OnCancel="ViewModel.CloseModals" />
}

@if (ViewModel.ShowEditModal && ViewModel.SelectedEmployee != null)
{
    <EditEmployeeModal ViewModel="ViewModel.EditModalViewModel" 
                       Employee="@ViewModel.SelectedEmployee"
                       OnSaved="ViewModel.OnEmployeeUpdatedAsync"
                       OnCancel="ViewModel.CloseModals" />
}

@if (ViewModel.ShowDeleteModal && ViewModel.SelectedEmployee != null)
{
    <DeleteEmployeeModal ViewModel="ViewModel.DeleteModalViewModel" 
                         Employee="@ViewModel.SelectedEmployee"
                         OnDeleted="ViewModel.OnEmployeeDeletedAsync"
                         OnCancel="ViewModel.CloseModals" />
}

@if (ViewModel.ShowAssignModal && ViewModel.SelectedEmployee != null)
{
    <AssignEmployeeModal ViewModel="ViewModel.AssignModalViewModel"
                         Employee="@ViewModel.SelectedEmployee"
                         OnAssigned="ViewModel.OnEmployeeAssignedAsync"
                         OnCancel="ViewModel.CloseModals" />
}

@if (ViewModel.ShowDismissModal && ViewModel.SelectedEmployee != null)
{
    <DismissEmployeeModal ViewModel="ViewModel.DismissModalViewModel"
                          Employee="@ViewModel.SelectedEmployee"
                          OnDismissed="ViewModel.OnEmployeeDismissedAsync"
                          OnCancel="ViewModel.CloseModals" />
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadEmployeesAsync();
    }
}