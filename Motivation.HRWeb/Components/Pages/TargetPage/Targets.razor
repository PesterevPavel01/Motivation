@page "/targets"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Motivation.HRWeb.Components.Pages.TargetPage.ViewModels
@using Motivation.HRWeb.Application;
@inject TargetsViewModel ViewModel
@attribute [Authorize]

<PageTitle>Показатели</PageTitle>

<div class="row align-items-start mb-3">
    <div class="col-12 col-md-8">
        <h1 class="fs-4 m-0">Целевые показатели KPI</h1>
    </div>
    <div class="col-12 col-md-4">
        <div class="d-flex align-items-center gap-1 flex-wrap">
            <span class="p-2 pb-1">Фильтр</span>
            <div class="input-group input-group-sm">
                <span class="input-group-text">Месяц</span>
                <select class="form-select" @bind="ViewModel.Filter.Month">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i">@i</option>
                    }
                </select>
            </div>
            <div class="input-group input-group-sm">
                <span class="input-group-text">Год</span>
                <input type="number" class="form-control" @bind="ViewModel.Filter.Year" min="2020" max="2100" />
            </div>
            <div class="input-group input-group-sm">
                <span class="input-group-text">Сотрудник</span>
                <select class="form-select" @bind="ViewModel.Filter.EmployeeCode">
                    <option value="">-- Выберите --</option>
                    @foreach (var employee in ViewModel.Filter.Employees!)
                    {
                        <option value="@employee.Code">@employee.FullName</option>
                    }
                </select>
            </div>
            <button class="btn btn-primary btn-sm" @onclick="() => ViewModel.ApplyFilterAsync()" disabled="@ViewModel.IsLoading">
                <i class="bi bi-arrow-clockwise"></i> Применить
            </button>
        </div>
    </div>
</div>

@if (ViewModel.IsLoading)
{
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Загрузка...</span>
    </div>
}
else if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>Ошибка:</strong> @ViewModel.ErrorMessage
    </div>
}
else if (ViewModel.Filter.Employees == null || !ViewModel.Filter.Employees.Any())
{
    <div class="alert alert-info">Сотрудники не найдены.</div>
}
else
{
    @if (!ViewModel.Items.Any())
    {
        <div class="alert alert-info">Нет данных для отображения. Выберите сотрудника и нажмите "Применить".</div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded bg-white p-2">
            <table class="table table-sm table-hover table-bordered align-middle small mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-1">Сотрудник</th>
                        <th class="py-1">Должность</th>
                        <th class="py-1">Показатель</th>
                        <th class="py-1 text-center">Цель</th>
                        <th class="py-1 text-center">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ViewModel.Items)
                    {
                        <tr>
                            <td class="py-1"><strong>@item.EmployeeTitle</strong></td>
                            <td class="py-1">@item.PositionTitle</td>
                            <td class="py-1">@item.KpiTitle</td>
                            <td class="py-1 text-center">
                                @if (item.IsEditing)
                                {
                                    <input type="number"
                                           class="form-control form-control-sm d-inline-block employee-hours-input"
                                           @bind="item.EditValue"
                                           step="0.01"
                                           min="0"
                                           disabled="@item.IsSaving"
                                           style="max-width: 120px;" />
                                }
                                else
                                {
                                    <span>@(item.Target.HasValue ? ValueFormatter.FormatValue(item.Target.Value) : "—")</span>
                                }
                            </td>
                            <td class="py-1 text-center">
                                @if (item.IsEditing)
                                {
                                    <button class="btn btn-outline-success btn-sm me-1"
                                            @onclick="() => ViewModel.SaveTargetAsync(item)"
                                            disabled="@item.IsSaving"
                                            title="Сохранить">
                                        <i class="bi bi-floppy-fill"></i>
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm"
                                            @onclick="() => ViewModel.CancelEditing(item)"
                                            disabled="@item.IsSaving"
                                            title="Отменить">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-outline-secondary btn-sm"
                                            @onclick="() => ViewModel.StartEditing(item)"
                                            title="Редактировать цель">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-2 d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-secondary">Всего: @ViewModel.ItemsCount</span>
            </div>
        </div>
    }
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadEmployeesAsync();
    }
}